#
# Makefile for SCRAM-SHA-256 Plugin
#
# Compatibility: GNU
#

#
# Installation dirs...
#
prefix = @prefix@
DESTDIR = @DESTDIR@
LIBDIR = $(DESTDIR)$(prefix)/@MULBERRY_DIR@

#
# tools used for compiling / installing...
#
CXX = @CXX@
AR = @AR@
INSTALL = @INSTALL@
STRIP = @STRIP@
HAS_MM = @HAS_MM@
PRELINK = @PRELINK@
O = .o
E =
A = .a
D = .so

#
# Name of target object files:
#
LIBRARY = SCRAMSHA256Plugin
OBJS = ../Common/CAuthPluginDLL$O \
	../SCRAM-SHA-1/sources/CSCRAMPluginDLL$O \
	sources/CSCRAMSHA256PluginDLL$O \
	../Common/CPluginDLL$O \
	../../Sources_Common/Utilities/CStringUtils_plugin$O \
	PluginDLLmain$O \
	../Common/kbase64$O \
	../Common/os_dep$O

.PHONY : all clean distclean debug install uninstall

#
# Main target and file dependencies:
#

all: $(LIBRARY)$D

#
# Flags passed to the compiler
#

JX_ROOT = ../../Libraries/JX
JX_MAKE_INCLUDE_DIR = $(JX_ROOT)/include/make
include $(JX_MAKE_INCLUDE_DIR)/jx_constants
include $(JX_MAKE_INCLUDE_DIR)/jx_config
CXXDEBUG = -g
CXXOPT = @CXXOPT@
CXXWARN = @CXXWARN@
CPPFLAGS = @CPPFLAGS@ $(J_RAW_SYSTEM_STUFF) -D_REENTRANT -I../Common -I../../Sources_Common/Utilities -I./sources -I../SCRAM-SHA-1/sources
CXXFLAGS = -include ../Common/Plugin_Prefix_Linux.h @CXXFLAGS@ $(CPPFLAGS) $(CXXOPT) $(CXXDEBUG) $(CXXWARN)
COPT = @COPT@
CDEBUG = -g
CWARN = @CWARN@
CFLAGS = @CFLAGS@ -include ../Common/Plugin_Prefix_Linux.h $(CPPFLAGS) $(COPT) $(CDEBUG) $(CWARN)
SO_LDFLAGS = -lcrypto @SO_LDFLAGS@

include ../include/pluginrules.mak

ifeq (yes,${HAS_MM})
-include $(DEPENDS)
endif

